# Copie ce fichier en "config.env", puis remplis-le.
# Tout peut aussi se changer depuis WhatsApp : .setvar CLÉ=VALEUR

# --- Session ---------------------------------------------------------------
# SESSION_ID depuis ton site de session (https://nexora-inky-delta.vercel.app).
# Laisse vide pour te connecter avec le QR affiché au démarrage,
# ou mets PAIRING_NUMBER pour recevoir un code d'appairage.
SESSION_ID=""
PAIRING_NUMBER=""

# --- Bot -------------------------------------------------------------------
BOT_NAME="Nyx"
BOT_LANG="fr"
PREFIX="."
# private : toi + sudo uniquement · public : tout le monde (commandes publiques)
MODE="private"
SUDO=""

# --- Mises à jour ----------------------------------------------------------
# true : installe les mises à jour toute seule · false : te prévient seulement
AUTO_UPDATE="false"
UPDATE_INTERVAL="6"

# --- Comportement ----------------------------------------------------------
ALWAYS_ONLINE="false"
SEND_READ="false"
REJECT_CALL="false"
AUTO_STATUS_VIEW="false"
STATUS_VIEW_EMOJI=""
# false · p (vers toi) · g (même discussion) · un numéro
ANTI_DELETE="false"
STICKER_PACKNAME="Nyx,Nyx Bot"

# --- IA (une des deux suffit) ---------------------------------------------
GEMINI_API_KEY=""
GROQ_API_KEY=""

TZ="Africa/Abidjan"
