# Copie ce fichier en "config.env", puis remplis-le.
# Tout peut aussi se changer depuis WhatsApp : .setvar CLÉ=VALEUR

# --- Session ---------------------------------------------------------------
# SESSION_ID depuis le site de session Nyx : https://nyx-session.vercel.app
# Laisse vide pour te connecter avec le QR affiché au démarrage,
# ou mets PAIRING_NUMBER pour recevoir un code d'appairage.
SESSION_ID=""
PAIRING_NUMBER=""

# --- Bot -------------------------------------------------------------------
BOT_NAME="Nyx"
# Ton nom, affiché dans le message de bienvenue (vide = nom de ton compte WhatsApp)
OWNER_NAME=""
BOT_LANG="fr"
PREFIX="."
# private : toi + sudo uniquement · public : tout le monde (commandes publiques)
MODE="private"
SUDO=""

# --- Mises à jour ----------------------------------------------------------
# true : installe les mises à jour toute seule · false : te prévient seulement
AUTO_UPDATE="false"
UPDATE_INTERVAL="6"

# --- Comportement ----------------------------------------------------------
ALWAYS_ONLINE="false"
SEND_READ="false"
REJECT_CALL="false"
# --- Statuts ----------------------------------------------------------------
# false · true (voir + recevoir chaque statut) · ou des options combinables :
#   no-dl (voir sans recevoir) · hide-view (sans « vu ») · &delay (attente aléatoire)
#   only-view 225…,225… (seulement eux) · except-view 225… (tout le monde sauf eux)
AUTO_STATUS_VIEW="false"
STATUS_VIEW_EMOJI=""
# Message envoyé à l'auteur d'un statut (au plus 1 fois toutes les 12 h par contact)
STATUS_VIEW_MSG=""
# Où recevoir les statuts : vide = ta discussion, ou un numéro
STATUS_FORWARD_JID=""

# --- Divers -----------------------------------------------------------------
# false · p (vers toi) · g (même discussion) · un numéro
ANTI_DELETE="false"
STICKER_PACKNAME="Nyx,Nyx Bot"

# --- IA (une des deux suffit) ---------------------------------------------
GEMINI_API_KEY=""
GROQ_API_KEY=""

TZ="Africa/Abidjan"
